<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same framework as the extension, which runs inside Visual Studio on .NET Framework. -->
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FancyComments\FancyComments.csproj" />
  </ItemGroup>
</Project>
